
#основной принцип "плохости"- докер запускает снова команду, только если 
#1)изменилась сама команда 2)если до команды что-то изменилось. Если это не так = он берет, что в кеше лежит
# а лежать там может всякое. 

FROM python:latest
#завтра может выйти новый питон и все упадет + это очень много весит

WORKDIR /app

#создается папка арр которой вообще в проекте не было (как корневой) и туда копируется бэк
COPY . .
# копируется вообще ВСЕ то есть и .venv и .env а это вообще не надо
#пип инсталл, который ниже, будет теперь запускаться КАЖДЫЙ РАЗ, когда ты что-то меняешь в коде и запускаешь образ, 
# т.к. это считается изменившейся строчкой, а в этой строчке вообще ВЕСЬ код.


RUN apt-get update 
#эта штука берет список свежих пакетов просто и передает вниз установщику
RUN apt-get install -y curl vim git build-essential libpq-dev
#а эта штука смотрит и устанавливает те версии, которые в списке выше

#докер смотрит на апдейт. Команда сама не изменилась, до нее не изменилось ничего. значит, еще раз запускать не будем.
#Прошел год. Теперь наш горе-разработчик что-нибудь новенькое добавляет в инсталл. 
#Инсталл в кои веки запускается и берет старые версии из листа выше. 
#А старые версии пакетов больше не поддерживаются и их нету нигде. Ура, все упало!
#Или встала доисторическая версия пакетов.

# это всякие пакетики, которые для запуска нужны, а для работы приложения - нет. 


RUN pip install -r requirements.txt
# эта штука у нас будет по двести раз запускаться т.к. после COPY . .
#--no-cache-dir здесь надо поставить, иначе мусора будет много сохраняться


ENV DATABASE_URL=postgresql+psycopg://postgres:yourpassword@db:5432/notes_service
ENV SECRET_KEY=super-secret-123
ENV POSTGRES_PASSWORD=yourpassword
# секреты хардкодом прописаны и это даже если все стереть-переписать будет видно, т.к. в кэше будет в докере
#еще на гитхаб запушить и совсем грустно
# через docker inspect или docker history любой увидит

EXPOSE 5100

CMD flask --app run.py run --port 5100
#эта штука написана так, что бедному докеру придется запускать через shell ее
#То есть докер разворачивает Шелл, а Шелл разворачивает Флэск
#Теперь остановим докер. Докер говорит Шеллу остановиться корректно, ждет 10 секунд и все грубо закрывает, если 
#само не остановилось. А Шелл Флэску команду остановиться не передаст. И Флэск будет крутиться.
#И все будет обречено на скоропостижную смерть через 10 секунд. Прощайте, данные из БД.

# + у нас root на автомате, для хакеров подарок делаем
#Порт проброшеный в докере не долетит до Флэск, т.к. для этого нужно порт прописать 0.0.0.0 а по умолчанию вообще другое
#А еще миграции не прописаны, но они вроде в compose прописываются

#нужен healthcheck + .dockerignore
